+
+        let metadata: [String: String] = [
+            "schema": "cfp.trellis2-mlx-conditioning.v1",
+            "tier": mode.rawValue,
+            "view_angles": request.viewAngles.map(String.init).joined(separator: ","),
+            "view_count": String(views.count),
+            "conditioner": "DINOv3",
+        ]
+        let artifact = try MLX.saveToData(arrays: arrays, metadata: metadata)
+        var report: [String: Any] = [
+            "schema": metadata["schema"]!,
+            "status": "CONDITIONING_READY",
+            "conditioner": "DINOv3",
+            "tier": mode.rawValue,
+            "view_angles": request.viewAngles,
+            "view_count": views.count,
