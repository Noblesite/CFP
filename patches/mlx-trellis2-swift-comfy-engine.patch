--- a/Sources/TRELLIS2/MeshBake.swift
+++ b/Sources/TRELLIS2/MeshBake.swift
@@ -25,0 +26,10 @@ public struct BakedMesh {
+/// Geometry-only result from the shared dual-grid extraction and cleanup tail.
+///
+/// This intentionally carries no UVs, texture atlas, material channels, or bake diagnostics.
+/// It is suitable for manufacturing-focused GLB export and for future standalone mesh passes.
+public struct GeometryMesh {
+    public let vertices: MLXArray   // [V,3]
+    public let faces: MLXArray      // [F,3] int32
+    public let normals: MLXArray    // [V,3]
+}
+
@@ -39,0 +50,66 @@ public enum MeshBake {
+    /// Extract and clean geometry without entering the UV/texture bake pipeline.
+    ///
+    /// The dual-grid surface, DC remesh, optional simplification, winding normalization, and
+    /// vertex-normal generation are shared manufacturing operations. UV unwrap, rasterization,
+    /// surface sampling, atlas writing, and inpainting are deliberately absent.
+    public static func runGeometry(
+        shapeFeats: MLXArray,
+        coords: MLXArray,
+        fineRes: Float,
+        remeshRes: Int = 256,
+        targetFaces: Int = 120_000,
+        log: (String) -> Void = { print($0) }
+    ) -> (GeometryMesh, BakeStageMetrics) {
+        var m = BakeStageMetrics()
+        var t = Date()
+        let margin: Float = 0.5
+        let dualVertices = (1 + 2 * margin) * MLX.sigmoid(shapeFeats[0..., 0..<3]) - margin
+        let intersected = shapeFeats[0..., 3..<6] .> 0
+        let quadLerp = softplus(shapeFeats[0..., 6..<7])
+        let coords3 = coords[0..., 1..<4]
+
+        let (rawVertices, rawFaces) = DualGridMesh.extract(
+            coords: coords3,
+            dualVerts: dualVertices,
+            intersected: intersected,
+            quadLerp: quadLerp,
+            gridSize: fineRes
+        )
+        MLX.eval(rawVertices, rawFaces)
+        var mesh = Mesh(vertices: rawVertices, faces: rawFaces)
+        m.rawDualgridS = -t.timeIntervalSinceNow
+        m.rawFaces = mesh.faceCount
+        log("  raw dual-grid: \(mesh.vertexCount) verts, \(mesh.faceCount) faces")
+
+        t = Date()
+        if remeshRes > 0 {
+            mesh = mesh.remeshDualContouring(resolution: remeshRes)
+            MLX.eval(mesh.vertices, mesh.faces)
+            log("  remeshed: \(mesh.vertexCount) verts, \(mesh.faceCount) faces")
+        } else {
+            log("  remesh skipped: \(mesh.vertexCount) verts, \(mesh.faceCount) faces")
+        }
+        m.remeshS = -t.timeIntervalSinceNow
+        m.remeshFaces = mesh.faceCount
+        m.simplifyFaces = mesh.faceCount
+
+        if mesh.faceCount > targetFaces {
+            t = Date()
+            mesh = mesh.simplify(targetNumFaces: targetFaces)
+            MLX.eval(mesh.vertices, mesh.faces)
+            mesh = mesh.unifyFaceOrientations()
+            MLX.eval(mesh.vertices, mesh.faces)
+            m.simplifyS = -t.timeIntervalSinceNow
+            m.simplifyFaces = mesh.faceCount
+            log("  simplified: \(mesh.vertexCount) verts, \(mesh.faceCount) faces")
+        }
+
+        let normals = mesh.vertexNormals()
+        MLX.eval(mesh.vertices, mesh.faces, normals)
+        m.finalFaces = mesh.faceCount
+        return (
+            GeometryMesh(vertices: mesh.vertices, faces: mesh.faces, normals: normals),
+            m
+        )
+    }
+
