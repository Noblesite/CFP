+/// Mesh result shared by the textured and manufacturing-focused geometry lanes.
+///
+/// Geometry-only generation deliberately leaves every texture-related field nil so callers can
+/// export a GLB without UV coordinates, images, samplers, or texture objects.
+public struct GeneratedMesh {
+    public let vertices: MLXArray
+    public let faces: MLXArray
+    public let normals: MLXArray
+    public let uvs: MLXArray?
+    public let texRGBA: [UInt8]?
+    public let atlasSize: Int?
+    public let coverage: Float?
+    public let mrRGBA: [UInt8]?
+    public let filledBeforeInpaint: [Bool]?
+    public let wallFlipped: [Bool]?
+
+    public var isTextured: Bool {
+        uvs != nil && texRGBA != nil && atlasSize != nil
+    }
+
+    public init(baked: BakedMesh) {
+        vertices = baked.vertices
+        faces = baked.faces
+        normals = baked.normals
+        uvs = baked.uvs
+        texRGBA = baked.texRGBA
+        atlasSize = baked.atlasSize
+        coverage = baked.coverage
+        mrRGBA = baked.mrRGBA
+        filledBeforeInpaint = baked.filledBeforeInpaint
+        wallFlipped = baked.wallFlipped
+    }
+
+    public init(geometry: GeometryMesh) {
+        vertices = geometry.vertices
+        faces = geometry.faces
+        normals = geometry.normals
+        uvs = nil
+        texRGBA = nil
+        atlasSize = nil
+        coverage = nil
+        mrRGBA = nil
+        filledBeforeInpaint = nil
+        wallFlipped = nil
+    }
+
+    private init(
+        vertices: MLXArray,
+        faces: MLXArray,
+        normals: MLXArray,
+        uvs: MLXArray?,
+        texRGBA: [UInt8]?,
+        atlasSize: Int?,
+        coverage: Float?,
+        mrRGBA: [UInt8]?,
+        filledBeforeInpaint: [Bool]?,
+        wallFlipped: [Bool]?
+    ) {
+        self.vertices = vertices
+        self.faces = faces
+        self.normals = normals
+        self.uvs = uvs
+        self.texRGBA = texRGBA
+        self.atlasSize = atlasSize
+        self.coverage = coverage
+        self.mrRGBA = mrRGBA
+        self.filledBeforeInpaint = filledBeforeInpaint
+        self.wallFlipped = wallFlipped
+    }
+
+    func reorientedYUp() -> GeneratedMesh {
+        func toYUp(_ array: MLXArray) -> MLXArray {
+            MLX.stacked([array[0..., 0], array[0..., 2], -array[0..., 1]], axis: 1)
+        }
+        return GeneratedMesh(
+            vertices: toYUp(vertices),
+            faces: faces,
+            normals: toYUp(normals),
+            uvs: uvs,
+            texRGBA: texRGBA,
+            atlasSize: atlasSize,
+            coverage: coverage,
+            mrRGBA: mrRGBA,
+            filledBeforeInpaint: filledBeforeInpaint,
+            wallFlipped: wallFlipped
+        )
+    }
+}
+
