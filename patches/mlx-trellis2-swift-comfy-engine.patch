+            throw PackageError.unsupportedRequestFeature(
+                "conditioning viewAngles count must match the number of images"
+            )
+        }
+
+        let mode = request.mode ?? configuration.defaultMode
+        let cascade = mode == ImageTo3DContract.res1024 || mode == ImageTo3DContract.res1536
+        let started = Date()
+        if let matting = configuration.matting {
+            for index in views.indices {
+                views[index] = try await ImagePreprocess.mattedIfNeeded(views[index], using: matting)
+                try Task.checkCancellation()
+            }
+        }
+
+        let px512 = try views.map { try ImagePreprocess.dinoPixels(from: $0, size: 512) }
+        let (cond512, negCond512) = pipeline.encodeImages(px512)
+        MLX.eval(cond512, negCond512)
+
+        var arrays: [String: MLXArray] = [
+            "cond_512": cond512,
+            "neg_cond_512": negCond512,
+        ]
+        var shape1024: [Int]? = nil
